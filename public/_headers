/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate, noai, noimageai
  Content-Security-Policy: frame-ancestors 'self'

# Everything under here carries a content hash in its name, so a URL never
# changes meaning: cache it for as long as the browser and the edge will.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Public artwork and media, served by the asset layer without the Worker
# (see `assets.run_worker_first` in `wrangler.jsonc`). A day in the browser,
# and a week of serving the old file while the edge fetches a new one.
/thumbnails/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/app-icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/logos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/fonts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/audio/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/avatars/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/onboarding/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/entertainment-setup/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/simulator/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
