{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "interactive-learning",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker.ts",
  "assets": {
    "run_worker_first": true,
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "account_id": "89714246ae34625deb2d528b5dbf6598",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  // Smart Placement: subrequests fan out to Clerk, Convex, and the
  // experience worker, so let Cloudflare place the worker near its backends
  // instead of near the visitor. Zero-cost latency win.
  "placement": { "mode": "smart" },
  "vars": {
    "EXPERIENCE_ORIGIN": "https://experience.interactivelearning-content-net.work",
  },
  "observability": {
    "redact_query_string": true,
    "enabled": true,
    // Dashboard audit (2026-09-21): logs and traces were persisted at 100%
    // sampling. ~50k invocations/week does not need full-fidelity sampling;
    // 10% keeps debugging signal while cutting log volume and overhead.
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": true,
    },
  },
  "routes": [
    {
      "pattern": "interactivelearningresources.org",
      "custom_domain": true,
    },
    {
      "pattern": "www.interactivelearningresources.org",
      "custom_domain": true,
    },
  ],
}
