{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "interactive-learning",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "account_id": "89714246ae34625deb2d528b5dbf6598",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "observability": {
    "redact_query_string": true,
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "routes": [
    {
      "pattern": "interactivelearningresources.org",
      "custom_domain": true,
    },
    {
      "pattern": "www.interactivelearningresources.org",
      "custom_domain": true,
    },
  ],
}
