# Static-asset headers for the experience origin. These cover the frontend files
# only; pages under /service/ are produced by the service worker, whose
# responses carry what the experience engine gives them.

/*
  X-Robots-Tag: noindex, nofollow, noarchive
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cache-Control: no-cache
  # Allow the production app and local development to embed Experience.
  # Device restrictions are enforced separately by the zone's ChromeOS rule.
  Content-Security-Policy: frame-ancestors 'self' https://interactivelearningresources.org https://www.interactivelearningresources.org http://localhost:3000
