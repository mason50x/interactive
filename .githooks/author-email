#!/bin/sh
# Vercel's Hobby plan will only build a commit whose author is the owner of the
# Hobby team. Anything authored under another address is accepted by GitHub,
# pushed, and then BLOCKED by Vercel with no build — so the author is checked
# here rather than discovered in the deploy log.
#
# The allowed address is `vercel.authorEmail` in git config, defaulting to the
# address on the Vercel account. Set VERCEL_AUTHOR_CHECK=0 to skip.

allowed_email() {
	git config --get vercel.authorEmail || echo 'masonsyzn@gmail.com'
}

report() {
	# $1 = a sentence naming the bad author, $2 = what was refused
	cat >&2 <<-MSG

	  $1
	  Vercel only builds commits authored by $(allowed_email). $2

	  Fix the address for this repo:

	    git config user.email $(allowed_email)

	  Then rewrite what is already committed:

	    git commit --amend --reset-author --no-edit     # the last commit
	    git rebase -i --exec 'git commit --amend --reset-author --no-edit' <base>

	  If the Vercel account is the one that changed, point the check at it:

	    git config vercel.authorEmail <new address>

	MSG
}
