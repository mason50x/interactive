#!/bin/sh
# Catch commits that arrived from somewhere the pre-commit hook did not run —
# another machine, a cloud agent, the GitHub web editor. Pushing one to main is
# what produces a BLOCKED production deploy. See .githooks/author-email.
set -e
. "$(dirname "$0")/author-email"

[ "${VERCEL_AUTHOR_CHECK:-1}" = 0 ] && exit 0

zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue          # branch deletion

	if [ "$remote_sha" = "$zero" ]; then            # new branch: exclude what is already pushed
		range="$local_sha --not --remotes=$1"
	else
		range="$remote_sha..$local_sha"
	fi

	# shellcheck disable=SC2086
	bad=$(git log --format='%h %ae' $range | grep -v " $(allowed_email)$" || true)

	if [ -n "$bad" ]; then
		echo "$bad" | while read -r sha email; do
			echo "  $sha  $email" >&2
		done
		status=1
	fi
done

if [ "$status" != 0 ]; then
	report "The commits above are authored by someone else." "They were not pushed."
	exit 1
fi
