{
  "name": "50x",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-urls.mjs && concurrently -n next,convex -c cyan,magenta --kill-others \"npm:dev:next\" \"npm:dev:convex\"",
    "domains": "node scripts/domains.mjs",
    "dev:next": "next dev",
    "dev:convex": "convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "deploy": "node scripts/deploy.mjs",
    "test:simulator": "node scripts/build-simulator-core.mjs && node scripts/check-simulator.mjs && vitest run",
    "test": "npm run test:simulator"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.63",
    "@base-ui/react": "^1.7.0",
    "@clerk/nextjs": "^7.8.3",
    "@convex-dev/agent": "^0.7.1",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@heroicons/react": "^2.2.0",
    "ai": "^7.0.93",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.0",
    "svix": "^2.1.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "convex-test": "^0.0.56",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  }
}
