{
  "name": "rift",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-urls.mjs && concurrently -n app,convex -c cyan,magenta --kill-others \"npm:dev:app\" \"npm:dev:convex\"",
    "domains": "node scripts/domains.mjs",
    "dev:convex": "convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:simulator": "node scripts/build-simulator-core.mjs && node scripts/check-simulator.mjs && vitest run",
    "test": "npm run test:simulator",
    "dev:app": "next dev --port 3000",
    "build:production": "convex deploy --cmd \"npm run build\" --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL",
    "check:tv-artwork": "node scripts/check-tv-artwork.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.85",
    "@base-ui/react": "^1.8.0",
    "@clerk/nextjs": "^7.9.7",
    "@convex-dev/agent": "^0.7.3",
    "@convex-dev/rate-limiter": "^0.4.0",
    "@heroicons/react": "^2.2.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-bubble-menu": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "ai": "^7.0.122",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "emojibase-data": "^17.0.0",
    "input-otp": "^1.5.0",
    "micromark-util-decode-string": "^2.0.1",
    "motion": "^13.4.4",
    "next": "^16.3.6",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "svix": "^2.5.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.5",
    "convex-test": "^0.0.60",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module"
}
