# Local dev pulls these from Vercel: `vercel env pull`
# Convex — written by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk — written by `clerk init` / `clerk env pull`
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# The origin this deployment answers on. Invitations bake it into the link they
# email out, so it has to name the environment doing the sending — see
# src/lib/site-url.ts. Set on Vercel for Development (http://localhost:3000) and
# Production; deliberately unset for Preview, where VERCEL_URL names the
# deployment and a stored value could only ever be wrong.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The origin games run on. Games are third-party code, so they get a hostname
# of their own and the browser keeps them away from the Clerk session and the
# Convex client — src/lib/player.ts has the full reasoning. Same deployment,
# second domain: `src/proxy.ts` routes on the Host header.
#
# Locally that is this same dev server reached as 127.0.0.1, which the browser
# treats as a different origin to localhost. Set to the player domain on Vercel
# for Production; leave UNSET for Preview, where the deployment has one
# hostname and games fall back to /player/<slug> on the app's own origin.
NEXT_PUBLIC_PLAYER_ORIGIN=http://127.0.0.1:3000

# Signs the short grants that let a game load on the player origin. The session
# cannot cross that boundary, so this is what stands in for it — see
# src/lib/player-token.ts. Required in every environment: without it the player
# origin refuses every request rather than serving games unauthenticated.
#   openssl rand -base64 32
PLAYER_TOKEN_SECRET=

# Set on Vercel (Production, Sensitive) only — not needed locally:
#   CONVEX_DEPLOY_KEY  lets the Vercel build run `npx convex deploy`
#   npx convex deployment token create vercel-production --prod

# Set on the Convex deployment, NOT in this file (repeat with --prod for the
# production deployment — the Clerk production instance has its own issuer
# domain and its own webhook signing secret):
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-app>.clerk.accounts.dev
#   npx convex env set CLERK_WEBHOOK_SECRET whsec_...

# Where hosted game bundles are served from — the public URL of the R2 bucket,
# which is a custom domain like https://assets.example.org (r2.dev works for a
# smoke test but is rate-limited and not for production traffic).
#
# There are ~18,000 bundle files and 5.4 GB of them. They are deliberately not
# in this repo: that is past Vercel's 15,000-file deployment limit, and serving
# them from Vercel would bill every byte as Fast Data Transfer. R2 has no
# egress charge. See src/lib/assets.ts, and scripts/migrate-to-r2.mjs for how
# the bucket gets filled.
#
# Leave UNSET and hosted games simply do not appear — the authored React games
# keep working, which is what makes a bare `next dev` useful with no bucket.
NEXT_PUBLIC_ASSET_ORIGIN=

# NOT set here and never in .env.local: the R2 write credentials. This file is
# pulled from Vercel and read by the app, which only ever reads the bucket over
# plain HTTP and has no business holding keys that can write to it. Export them
# into your shell for the one command that needs them:
#   R2_ACCOUNT_ID  R2_ACCESS_KEY_ID  R2_SECRET_ACCESS_KEY  R2_BUCKET
#   node scripts/migrate-to-r2.mjs
