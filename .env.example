# Copy to .env.local. Use your own development services; never commit real keys.
# Complete setup and backend-only variables: docs/environment.md

# Written by `npx convex dev`:
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Your Clerk development application:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional mail/brand domain override; otherwise config/domains.json is the fallback.
NEXT_PUBLIC_BRAND_DOMAIN=

# Optional, cosmetic admin badges ONLY. Does not grant backend permissions.
# Comma-separated Clerk user IDs; match CHAT_ADMIN_CLERK_IDS on Convex.
NEXT_PUBLIC_CHAT_ADMIN_CLERK_IDS=

# Optional public asset bucket URL, separate from the app origin.
# Empty disables hosted activities. No R2 write credentials belong in this file.
ASSET_ORIGIN=
# Legacy alias; ASSET_ORIGIN takes precedence.
NEXT_PUBLIC_ASSET_ORIGIN=

# Optional development-only Worker:
EXPERIENCE_ORIGIN=
NEXT_PUBLIC_EXPERIENCE_ORIGIN=

# Configure on EACH Convex deployment in its dashboard (not in this file):
# CLERK_JWT_ISSUER_DOMAIN = your Clerk issuer URL
# CLERK_WEBHOOK_SECRET   = that instance's webhook signing secret
# CLERK_SECRET_KEY       = required by account sync, including local development
# CHAT_ADMIN_CLERK_IDS   = comma-separated verified Clerk subjects; empty denies all
# OPENAI_API_KEY         = optional image moderation credential
# IMAGES_ENABLED         = 1 to allow image uploads (requires moderation key)
# GEMINI_API_KEY         = optional bot replies; unset disables model calls
# GEMINI_MODEL           = optional model override

# Production app hosting ONLY, never fork PR checks:
# CONVEX_DEPLOY_KEY = deploys Convex during the Vercel build AND is used by
# server-side account sync at runtime. Treat it as a privileged backend credential.
# Local development uses the authenticated Convex action and needs no deploy key.

# Asset maintenance only: export in a short-lived shell, outside app hosting:
# R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET
# Optional scripts: GITHUB_TOKEN (catalogue API rate limits), PROD_SITE_URL (invites).
